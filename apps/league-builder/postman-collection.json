      "item": [
        {
          "name": "Get Team Roster",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/teams/{{team_id}}/roster?seasonId={{season_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "teams", "{{team_id}}", "roster"],
              "query": [
                {
                  "key": "seasonId",
                  "value": "{{season_id}}",
                  "description": "Season UUID (required)"
                }
              ]
            },
            "description": "Retrieves all active players on a team roster for a specific season."
          },
          "response": [
            {
              "name": "Success - Roster Retrieved",
              "originalRequest": {
                "method": "GET",
                "header": [],
