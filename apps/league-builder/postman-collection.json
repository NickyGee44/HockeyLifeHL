              "body": "[\n  {\n    \"id\": \"uuid\",\n    \"team_id\": \"uuid\",\n    \"player_id\": \"uuid\",\n    \"season_id\": \"uuid\",\n    \"division_id\": \"uuid\",\n    \"jersey_number\": 99,\n    \"position\": \"forward\",\n    \"status\": \"active\",\n    \"leadership_role\": \"captain\",\n    \"start_date\": \"2024-01-01T00:00:00Z\",\n    \"end_date\": null,\n    \"full_name\": \"John Doe\",\n    \"email\": \"john@example.com\"\n  }\n]"
