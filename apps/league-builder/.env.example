# =============================================================================
# League Builder Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is gitignored.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Platform)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET_ORGANIZATIONS=your-webhook-secret
STRIPE_WEBHOOK_SECRET_CONNECT=your-webhook-secret-connect
STRIPE_WEBHOOK_SECRET_PLAYER_PAYMENTS=your-webhook-secret-player-payments

# Sentry Error Monitoring
# DSN is safe to expose client-side (it's a public ingest endpoint)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# Auth token is needed for source map uploads at build time
# Ask Nick for the token, or generate one at https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Cron Jobs (Vercel Cron)
# Used to authenticate cron requests — set a random secret string
CRON_SECRET=your-cron-secret-here

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://beerleaguehockey.ca
