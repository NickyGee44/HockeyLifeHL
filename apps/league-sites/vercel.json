{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@hockey-life/league-sites",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/push-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/auto-finalize-games",
      "schedule": "30 * * * *"
    }
  ]
}
