+  const client: any = {
+    from,
+    functions,
+    rpc: jest.fn((fnName: string, rpcArgs: any) => {
+      const step = steps.shift();
+      expect(step?.type).toBe('rpc');
+      expect(step?.target).toBe(fnName);
+      step?.assert?.({ filters: [], rpcArgs });
