/**
 * Test Resend Email Configuration
 *
 * Purpose: Verify that Resend API is working and domain is verified
 * Run: npx tsx test-resend.ts
 */

import { Resend } from 'resend';

const resend = new Resend(process.env.RESEND_API_KEY);

async function testResend() {
  console.log('🏒 Testing Resend Email Configuration...\n');

  // Check API key is configured
  if (!process.env.RESEND_API_KEY) {
    console.error('❌ ERROR: RESEND_API_KEY not found in environment variables');
    console.error('   Add it to your .env.local file\n');
    process.exit(1);
  }

  console.log('✅ API Key found:', process.env.RESEND_API_KEY.substring(0, 10) + '...\n');

  try {
    // Test 1: Get API key info
    console.log('Test 1: Verifying API key...');
    const domains = await resend.domains.list();
    console.log('✅ API key is valid\n');

    // Test 2: Check domain verification
    console.log('Test 2: Checking domain verification...');
    if (domains.data && domains.data.length > 0) {
      console.log('Domains configured:');
      domains.data.forEach((domain: any) => {
        const status = domain.status === 'verified' ? '✅' : '⚠️';
        console.log(`  ${status} ${domain.name} - ${domain.status}`);

        if (domain.status !== 'verified') {
          console.log(`     ⚠️  Domain not verified. Add these DNS records:`);
          if (domain.records) {
            domain.records.forEach((record: any) => {
              console.log(`        ${record.type}: ${record.name} → ${record.value}`);
            });
          }
        }
      });
      console.log('');
    } else {
      console.log('⚠️  No domains configured');
      console.log('   Go to https://resend.com/domains and add hockeylifehl.app\n');
    }

    // Test 3: Send test email
    console.log('Test 3: Sending test email...');
    const { data, error } = await resend.emails.send({
      from: 'HockeyLifeHL Test <noreply@hockeylifehl.app>',
      to: ['test@resend.dev'], // Resend test email address
      subject: 'HockeyLifeHL - Resend Test Email',
      html: `
        <h1>🏒 HockeyLifeHL Multi-Tenant Setup</h1>
        <p>This is a test email from your Resend configuration.</p>
        <p><strong>Status:</strong> Email system working correctly!</p>
        <hr>
        <p style="color: #666; font-size: 12px;">
          Sent from: ${process.env.NEXT_PUBLIC_APP_URL || 'localhost:3000'}<br>
          Date: ${new Date().toISOString()}
        </p>
      `,
    });

    if (error) {
      console.error('❌ Failed to send test email:', error);

      if (error.message?.includes('domain')) {
        console.error('\n   This usually means your domain is not verified.');
        console.error('   Go to: https://resend.com/domains');
        console.error('   Add DNS records shown for hockeylifehl.app\n');
      }
    } else {
      console.log('✅ Test email sent successfully!');
      console.log('   Email ID:', data?.id);
      console.log('   Check: https://resend.com/emails\n');
    }

    // Summary
    console.log('='.repeat(50));
    console.log('📊 SUMMARY');
    console.log('='.repeat(50));

    const hasVerifiedDomain = domains.data?.some((d: any) => d.status === 'verified');

    if (hasVerifiedDomain && !error) {
      console.log('✅ Resend is fully configured and working!');
      console.log('✅ You can send emails from hockeylifehl.app\n');
      console.log('Next steps:');
      console.log('  1. Configure Stripe Connect (see STRIPE_CONNECT_SETUP.md)');
      console.log('  2. Run database migrations\n');
    } else if (!hasVerifiedDomain) {
      console.log('⚠️  Resend API key works, but domain not verified');
      console.log('\nTO FIX:');
      console.log('  1. Go to: https://resend.com/domains');
      console.log('  2. Click on hockeylifehl.app (or add it if missing)');
      console.log('  3. Add the DNS records shown to your domain registrar');
      console.log('  4. Wait 5-30 minutes for verification');
      console.log('  5. Run this test again: npx tsx test-resend.ts\n');
    } else {
      console.log('⚠️  Email sending failed - check error above\n');
    }

  } catch (err: any) {
    console.error('❌ ERROR:', err.message);

    if (err.message?.includes('Invalid API key')) {
      console.error('\n   Your RESEND_API_KEY is invalid.');
      console.error('   Get a new one from: https://resend.com/api-keys\n');
    } else {
      console.error('\n   Unexpected error. Full details:');
      console.error(err);
    }

    process.exit(1);
  }
}

testResend();
